# Generate strong random values for production:
#   openssl rand -hex 32
DATABASE_URL=postgres://aegis:your-db-password@localhost:5432/aegis?sslmode=disable
AEGIS_API_KEY=your-secret-key-here
# Separate key for DEFER approval endpoints so agents can't approve their own
# deferred calls. Falls back to AEGIS_API_KEY if unset (a warning is logged).
AEGIS_ADMIN_KEY=your-admin-key-here
AEGIS_ADDR=:8080
POSTGRES_PASSWORD=your-db-password

# Note: sslmode=disable is fine for local Docker dev.
# In production, use sslmode=require (or verify-full) and a real certificate.
# Never commit this file with real values.
